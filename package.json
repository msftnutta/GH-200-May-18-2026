{
  "name": "world-clock-weather",
  "version": "1.0.0",
  "description": "Modern world clock + weather web app (Express, EJS, Tailwind, Azure Maps).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --minify",
    "dev:css": "tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --watch",
    "build": "npm run build:css",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^5.0.2",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.47",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.13"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "clearMocks": true
  }
}
