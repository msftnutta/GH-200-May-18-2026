<header class="flex items-center justify-between">
  <div class="flex items-center gap-3">
    <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-sky-400 to-indigo-600 grid place-items-center text-xl shadow-md">🌍</div>
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">World Clock & Weather</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Local time and current conditions across the globe</p>
    </div>
  </div>
  <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle theme">
    <span class="hidden dark:inline">☀️</span>
    <span class="inline dark:hidden">🌙</span>
  </button>
</header>
