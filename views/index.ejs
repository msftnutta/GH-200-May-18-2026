<!DOCTYPE html>
<html lang="en" class="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>World Clock & Weather</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌍</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <script>
    // Apply theme before paint to avoid FOUC
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var dark = saved ? saved === 'dark' : prefersDark;
        if (dark) document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>
</head>
<body class="min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%- include('partials/header') %>

    <main class="mt-8 space-y-12">

      <!-- ====== World Map ====== -->
      <section aria-labelledby="map-title">
        <div class="flex items-end justify-between mb-3">
          <h2 id="map-title" class="text-lg font-semibold">Interactive World Map</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 hidden sm:block">Hover or tap a marker</p>
        </div>

        <div class="relative rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-gradient-to-b from-sky-50 to-indigo-50 dark:from-slate-900 dark:to-slate-950 shadow-sm">
          <svg id="world-map"
               viewBox="0 0 <%= mapW %> <%= mapH %>"
               class="w-full h-auto block select-none"
               role="img"
               aria-label="World map with city markers">
            <defs>
              <radialGradient id="ocean" cx="50%" cy="50%" r="75%">
                <stop offset="0%"  stop-color="currentColor" stop-opacity="0" />
                <stop offset="100%" stop-color="currentColor" stop-opacity="0.05" />
              </radialGradient>
              <filter id="marker-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="3" result="b" />
                <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>

            <!-- Ocean wash -->
            <rect width="<%= mapW %>" height="<%= mapH %>" fill="url(#ocean)" class="text-sky-500 dark:text-sky-400" />

            <!-- Stylized continents -->
            <g class="text-slate-300 dark:text-slate-700" fill="currentColor" stroke="currentColor" stroke-opacity="0.4" stroke-width="0.5" stroke-linejoin="round">
              <% continents.forEach(function(c) { %>
                <path d="<%= c.d %>" />
              <% }); %>
            </g>

            <!-- City markers -->
            <g id="markers">
              <% cities.forEach(function(c) { %>
                <g class="marker group cursor-pointer focus:outline-none"
                   data-city-id="<%= c.id %>"
                   data-tz="<%= c.timezone %>"
                   transform="translate(<%= c.x.toFixed(1) %>, <%= c.y.toFixed(1) %>)"
                   tabindex="0"
                   role="button"
                   aria-label="<%= c.name %>, <%= c.country %>">
                  <circle r="10" class="fill-sky-500/0 group-hover:fill-sky-500/20 group-focus:fill-sky-500/20 transition-all" />
                  <circle r="5"  class="fill-sky-500/30 animate-ping" style="animation-duration: 2s;" />
                  <circle r="3.5" class="fill-sky-600 dark:fill-sky-400 stroke-white dark:stroke-slate-900" stroke-width="1" filter="url(#marker-glow)" />
                </g>
              <% }); %>
            </g>
          </svg>

          <!-- Callout (positioned via JS) -->
          <div id="callout"
               class="pointer-events-none absolute hidden z-10 w-64 p-4 rounded-xl bg-white/95 dark:bg-slate-900/95 backdrop-blur border border-slate-200 dark:border-slate-800 shadow-xl">
            <div class="flex items-start justify-between gap-2">
              <div>
                <div class="text-base font-semibold leading-tight">
                  <span id="co-name"></span>
                </div>
                <div id="co-country" class="text-xs text-slate-500 dark:text-slate-400"></div>
              </div>
              <div id="co-emoji" class="text-2xl leading-none" aria-hidden="true"></div>
            </div>
            <div class="mt-3">
              <div id="co-clock" class="font-mono text-2xl tabular-nums tracking-tight">--:--:--</div>
              <div id="co-date"  class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">—</div>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-800 flex items-baseline justify-between">
              <div>
                <div id="co-temp" class="text-xl font-semibold">—</div>
                <div id="co-phrase" class="text-xs text-slate-500 dark:text-slate-400">—</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====== Grouped by continent ====== -->
      <% grouped.forEach(function(group) { %>
        <section aria-labelledby="grp-<%= group.name.replace(/\s+/g, '-') %>">
          <div class="flex items-end justify-between mb-3">
            <h2 id="grp-<%= group.name.replace(/\s+/g, '-') %>" class="text-lg font-semibold">
              <%= group.name %>
            </h2>
            <span class="text-xs text-slate-500 dark:text-slate-400"><%= group.cities.length %> cities</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            <% group.cities.forEach(function(c) { %>
              <article class="card" data-tz="<%= c.timezone %>" data-city-id="<%= c.id %>">
                <header class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="text-lg font-semibold leading-tight">
                      <%= c.name %>
                    </h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400"><%= c.country %></p>
                  </div>
                </header>

                <div>
                  <div class="clock" data-clock>--:--:--</div>
                  <div class="text-xs text-slate-500 dark:text-slate-400 mt-1" data-date>—</div>
                </div>

                <div class="mt-auto pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
                  <% if (c.weather) { %>
                    <div class="flex items-center gap-3">
                      <div class="text-3xl leading-none" aria-hidden="true"><%= c.weather.emoji %></div>
                      <div>
                        <div class="text-xl font-semibold">
                          <%= c.weather.temperatureC != null ? Math.round(c.weather.temperatureC) + '°C' : '—' %>
                        </div>
                        <div class="text-xs text-slate-500 dark:text-slate-400"><%= c.weather.phrase %></div>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="flex items-center gap-3">
                      <div class="text-3xl leading-none opacity-40">🌡️</div>
                      <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400">Weather unavailable</div>
                      </div>
                    </div>
                  <% } %>
                </div>
              </article>
            <% }); %>
          </div>
        </section>
      <% }); %>
    </main>

    <footer class="mt-10 text-center text-xs text-slate-500 dark:text-slate-400">
      Weather data © Azure Maps • Updated <%= generatedAt %>
    </footer>
  </div>

  <!-- City data for the map callout -->
  <script id="cities-data" type="application/json">
    <%- JSON.stringify(cities.map(function(c){ return {
      id: c.id, name: c.name, country: c.country,
      timezone: c.timezone,
      weather: c.weather
    }; })) %>
  </script>

  <script src="/js/theme.js"></script>
  <script src="/js/clock.js"></script>
  <script src="/js/map.js"></script>
</body>
</html>
